# OneLap 账号。程序在内存中处理密码，不会将其写入 SQLite。
ONELAP_ACCOUNT=
ONELAP_PASSWORD=
# 用于加密 SQLite 中动态更新的 OneLap token；请使用至少 32 字节的随机值。
ONELAP_SESSION_KEY=

# 可选的临时手工凭据。两项可以独立设置。
ONELAP_TOKEN=
ONELAP_REFRESH_TOKEN=

# Garmin 中国区 OAuth 会话 JSON。
GARMIN_CN_OAUTH1=
GARMIN_CN_OAUTH2=

# Garmin 国际区 OAuth 会话 JSON。
GARMIN_GLOBAL_OAUTH1=
GARMIN_GLOBAL_OAUTH2=

# 仅供本机执行 npm run session:* 生成 OAuth 会话。不要保存到 Actions，
# 也不要提交填写后的 .env。
GARMIN_CN_USERNAME=
GARMIN_CN_PASSWORD=
GARMIN_GLOBAL_USERNAME=
GARMIN_GLOBAL_PASSWORD=

# FIT 预处理配置。生产工作流要求 GARMINIZE_FIT_ENABLED=true。
FIT_COORDINATE_TRANSFORM_ENABLED=false
GARMINIZE_FIT_ENABLED=false
GARMIN_DEVICE_PRODUCT_ID=
GARMIN_DEVICE_UNIT_ID=
GARMIN_DEVICE_SOFTWARE_VERSION=

# 本地运行设置。
SYNC_TARGETS=CN,GLOBAL
SYNC_MAX_UPLOADS_PER_RUN=10
ONELAP_DISCOVERY_PAGES=10
SYNC_MAX_RETRIES=8
SYNC_DRY_RUN=true
SYNC_DATA_DIR=data
